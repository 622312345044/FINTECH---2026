# FinAgent — Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit the real .env file to GitHub.

# ── Groq (FREE — alternative fast LLM) ───────────────────────────────────────
# Get a free key at https://console.groq.com  (14,400 req/day)
# Set BACKEND = "groq" in [FINTECH]AIANALYSIS.ipynb to use this instead
GROQ_API_KEY=your_groq_api_key_here

# ── NewsAPI (optional — for news sentiment module) ───────────────────────────
# Get a free key at https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# ── Alpha Vantage (optional — alternative data source) ───────────────────────
# Free tier at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── FRED (Federal Reserve — macro data) ──────────────────────────────────────
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html  (unlimited)
FRED_API_KEY=your_fred_api_key_here

# ── NewsAPI (optional — for news sentiment module) ───────────────────────────
# Get a free key at https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# ── Alpha Vantage (optional — alternative data source) ───────────────────────
# Free tier at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

FRED_API_KEY=
console.groq.com